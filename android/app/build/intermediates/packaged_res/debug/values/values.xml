<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <color name="accent_gold">#E6B800</color>
    <color name="bg_dark">#17171B</color>
    <color name="bg_light">#F6F5F0</color>
    <color name="black">#FF000000</color>
    <color name="primary_dark">#17171B</color>
    <color name="primary_gold">#FFCC00</color>
    <color name="statusBarColor">#17171B</color>
    <color name="text_primary">#1A1A1E</color>
    <color name="white">#FFFFFFFF</color>
    <string name="app_name">Nyamimo</string>
    <string name="btn_retry">Coba Lagi</string>
    <string name="error_offline_desc">Pastikan perangkat Anda terhubung ke internet dan coba lagi.</string>
    <string name="error_offline_title">Koneksi Terputus</string>
    <string name="exit_prompt">Tekan sekali lagi untuk keluar dari Nyamimo</string>
    <string name="web_url">https://nyamimo.onrender.com</string>
    <style name="Theme.Nyamimo" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_gold</item>
        <item name="colorPrimaryVariant">@color/accent_gold</item>
        <item name="colorOnPrimary">@color/primary_dark</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar" ns1:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" ns1:targetApi="o_mr1">true</item>
    </style>
    <style name="Theme.Nyamimo.Fullscreen" parent="Theme.Nyamimo">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/primary_dark</item>
    </style>
</resources>