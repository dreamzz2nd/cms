<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="18dp"
    app:cardElevation="10dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_menu_unduhan"
                app:tint="#F5A623" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="Unduhan Saya"
                android:textColor="#17171B"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="14dp"
            android:background="#F0F0F0" />

        <TextView
            android:id="@+id/tvDownloadsSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Daftar anime yang tersimpan untuk ditonton offline:"
            android:textColor="#757580"
            android:textSize="12.5sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDownloadsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:maxHeight="260dp" />

        <TextView
            android:id="@+id/tvEmptyDownloads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="16dp"
            android:gravity="center"
            android:text="Belum ada anime yang diunduh.\nPutar anime saat online untuk mengunduh episode offline."
            android:textColor="#9CA3AF"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCloseDownloads"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#FFCC00"
            android:text="Tutup"
            android:textColor="#17171B"
            android:textSize="13.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
