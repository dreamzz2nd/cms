<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    app:cardCornerRadius="18dp"
    app:cardElevation="10dp"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- Mascot Logo & Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/logo_nyamimo" />

            <TextView
                android:id="@+id/tvAuthTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Akun Nyamimo"
                android:textColor="#17171B"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAuthSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Simpan bookmark anime &amp; riwayat tontonan"
                android:textColor="#757580"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Segmented Tab: Masuk vs Daftar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/search_pill_bg"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/tabAuthLogin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/badge_gold_bg"
                android:gravity="center"
                android:text="Masuk"
                android:textColor="#17171B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabAuthRegister"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:gravity="center"
                android:text="Daftar Akun"
                android:textColor="#757580"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Input Fields -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <!-- Username Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Pengguna / Username"
                android:textColor="#17171B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAuthUsername"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/search_pill_bg"
                android:hint="contoh: wibu_sejati"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:textColor="#17171B"
                android:textColorHint="#8E8E93"
                android:textSize="13sp" />

            <!-- Email Field (Visible only for Register) -->
            <LinearLayout
                android:id="@+id/layoutAuthEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Email"
                    android:textColor="#17171B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAuthEmail"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/search_pill_bg"
                    android:hint="email@contoh.com"
                    android:inputType="textEmailAddress"
                    android:paddingHorizontal="12dp"
                    android:textColor="#17171B"
                    android:textColorHint="#8E8E93"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Password Field -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Kata Sandi"
                android:textColor="#17171B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etAuthPassword"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/search_pill_bg"
                android:hint="Minimal 6 karakter"
                android:inputType="textPassword"
                android:paddingHorizontal="12dp"
                android:textColor="#17171B"
                android:textColorHint="#8E8E93"
                android:textSize="13sp" />

            <!-- Confirm Password Field (Visible only for Register) -->
            <LinearLayout
                android:id="@+id/layoutAuthConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Konfirmasi Kata Sandi"
                    android:textColor="#17171B"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etAuthConfirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/search_pill_bg"
                    android:hint="Ulangi kata sandi"
                    android:inputType="textPassword"
                    android:paddingHorizontal="12dp"
                    android:textColor="#17171B"
                    android:textColorHint="#8E8E93"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Submit Button -->
        <Button
            android:id="@+id/btnSubmitAuth"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#FFCC00"
            android:text="Masuk Sekarang"
            android:textColor="#17171B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Switch Link / Batal -->
        <TextView
            android:id="@+id/btnSwitchAuthMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:padding="4dp"
            android:text="Belum punya akun? Daftar sekarang"
            android:textColor="#D97706"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnCancelAuth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:padding="6dp"
            android:text="Tutup"
            android:textColor="#757580"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
