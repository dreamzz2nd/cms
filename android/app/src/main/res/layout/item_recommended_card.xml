<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="4dp"
    android:background="?attr/selectableItemBackground">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="1.5dp"
        app:cardBackgroundColor="#232328">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="125dp">

            <ImageView
                android:id="@+id/ivCardPoster"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop" />

            <!-- Dark gradient at bottom for text contrast -->
            <View
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_alignParentBottom="true"
                android:background="@drawable/banner_gradient_overlay" />

            <!-- Top Score Tag -->
            <TextView
                android:id="@+id/tvCardScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_margin="4dp"
                android:background="@drawable/badge_gold_bg"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1.5dp"
                android:text="★ 8.8"
                android:textColor="#17171B"
                android:textSize="8.5sp"
                android:textStyle="bold" />

            <!-- Bottom Episode Tag -->
            <TextView
                android:id="@+id/tvCardEpisode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_margin="4dp"
                android:background="#B3000000"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1.5dp"
                android:text="24 Episode"
                android:textColor="#FFFFFF"
                android:textSize="8.5sp" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvCardTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:minLines="2"
        android:text="Judul Anime"
        android:textColor="#17171B"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
