<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootAnimeDetail"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical">

    <!-- MAIN CONTAINER (Vertical in Portrait, Horizontal in Landscape) -->
    <LinearLayout
        android:id="@+id/mainContentRow"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- LEFT COLUMN (Portrait: 100% width. Landscape: ~62% width) -->
        <LinearLayout
            android:id="@+id/leftColumnLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Video Player Container (Portrait: 270dp, Landscape: 240dp or proportional, Fullscreen: match_parent) -->
            <RelativeLayout
                android:id="@+id/playerContainer"
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:background="#000000"
                android:keepScreenOn="true">

                <!-- Native ExoPlayer / Media3 -->
                <androidx.media3.ui.PlayerView
                    android:id="@+id/detailPlayerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#000000"
                    app:shutter_background_color="#000000"
                    app:resize_mode="zoom"
                    app:show_buffering="when_playing"
                    app:use_controller="true" />

                <!-- Accelerated WebView Container for iframe/server streams -->
                <WebView
                    android:id="@+id/detailPlayerWebView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#000000"
                    android:visibility="gone" />

                <!-- Cute Nyamimo Cat GIF Loading Mascot -->
                <ImageView
                    android:id="@+id/ivDetailLoadingGif"
                    android:layout_width="85dp"
                    android:layout_height="85dp"
                    android:layout_centerInParent="true"
                    android:visibility="gone" />

                <!-- Top Player Overlay Controls -->
                <LinearLayout
                    android:id="@+id/playerTopControls"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_alignParentTop="true"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/btnBackDetail"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/badge_dark_circle"
                        android:padding="6dp"
                        android:src="@android:drawable/ic_menu_revert"
                        app:tint="#FFFFFF" />

                    <!-- Title & Episode removed per user request (gone) -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvPlayerAnimeTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Judul Anime"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPlayerActiveEpisode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Episode 1"
                            android:textColor="#FFCC00"
                            android:textSize="10.5sp" />
                    </LinearLayout>

                    <!-- Landscape Server Bar Toggle -->
                    <TextView
                        android:id="@+id/btnLandscapeServerToggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/chip_genre_bg"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="Server"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- Fullscreen Toggle Icon removed per user request (gone) -->
                    <ImageView
                        android:id="@+id/btnFullscreenToggle"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="6dp"
                        android:src="@android:drawable/ic_menu_crop"
                        app:tint="#FFFFFF"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Landscape Server Bar -->
                <LinearLayout
                    android:id="@+id/playerLandscapeServerBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/playerTopControls"
                    android:background="#D9000000"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="6dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pilih Server:"
                        android:textColor="#FFCC00"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvLandscapeResolutions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="horizontal" />
                </LinearLayout>

                <!-- Watermark Overlay (Lebih Gede, Lebih Ke Bawah, Lebih Ke Kanan) -->
                <ImageView
                    android:id="@+id/ivVideoWatermark"
                    android:layout_width="170dp"
                    android:layout_height="60dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="24dp"
                    android:layout_marginEnd="6dp"
                    android:alpha="0.95"
                    android:elevation="100dp"
                    android:translationZ="100dp"
                    android:clickable="false"
                    android:focusable="false"
                    android:scaleType="fitEnd"
                    android:src="@drawable/watermark_nyamimo" />
            </RelativeLayout>

            <!-- Bstation Sub-header Tabs: Info & Komentar -->
            <LinearLayout
                android:id="@+id/bstationTabBar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:elevation="2dp">

                <LinearLayout
                    android:id="@+id/tabDetailInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Info"
                        android:textColor="#17171B"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="24dp"
                        android:layout_height="2.5dp"
                        android:layout_marginTop="3dp"
                        android:background="#FFCC00" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tabDetailKomentar"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="24dp"
                    android:gravity="center"
                    android:text="Komentar 3.1K"
                    android:textColor="#8E8E93"
                    android:textSize="14sp" />
            </LinearLayout>

            <View
                android:id="@+id/detailContentDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0" />

            <!-- Scrollable Detail Content (Left Side in Landscape, Full Width in Portrait) -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/detailContentScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="32dp">

                    <!-- 1. Anime Title & Sub-Info with Chevron (Opens Detail Sheet) -->
                    <LinearLayout
                        android:id="@+id/rowTitleAndMore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvDetailTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:text="Judul Anime"
                                android:textColor="#17171B"
                                android:textSize="17.5sp"
                                android:textStyle="bold" />

                            <!-- Views & Score -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/tvDetailViews"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:drawableStart="@drawable/ic_play_arrow"
                                    android:drawablePadding="3dp"
                                    android:gravity="center_vertical"
                                    android:text="Memuat penonton..."
                                    android:textColor="#757580"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvDetailScore"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/badge_gold_bg"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:text="Score 8.8"
                                    android:textColor="#17171B"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginStart="8dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#8E8E93" />
                    </LinearLayout>

                    <!-- 2. Trending / Top Rank Ribbon Banner -->
                    <LinearLayout
                        android:id="@+id/bannerRankRibbon"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/search_chip_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="12dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_trophy" />

                        <TextView
                            android:id="@+id/tvRankTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Umum Top 1 • Trending Anime Nyamimo"
                            android:textColor="#B45309"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_right"
                            app:tint="#B45309" />
                    </LinearLayout>

                    <!-- 3. Quick Interactive Action Bar (4 Items: Suka, Favorit, Unduh, Bagikan) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <!-- 1. Suka -->
                        <LinearLayout
                            android:id="@+id/btnDetailLike"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:id="@+id/ivDetailLikeIcon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_thumb_up"
                                app:tint="#17171B" />

                            <TextView
                                android:id="@+id/tvDetailLikeCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="209.4K"
                                android:textColor="#17171B"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- 2. Favorit -->
                        <LinearLayout
                            android:id="@+id/btnDetailBookmark"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:id="@+id/ivDetailBookmarkIcon"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_reels_bookmark"
                                app:tint="#17171B" />

                            <TextView
                                android:id="@+id/tvDetailBookmarkCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="771.2K"
                                android:textColor="#17171B"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- 3. Unduh -->
                        <LinearLayout
                            android:id="@+id/btnDetailDownload"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_menu_unduhan"
                                app:tint="#17171B" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Unduh"
                                android:textColor="#17171B"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- 4. Bagikan -->
                        <LinearLayout
                            android:id="@+id/btnDetailShare"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="?attr/selectableItemBackground">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_reels_share"
                                app:tint="#17171B" />

                            <TextView
                                android:id="@+id/tvDetailShareText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Bagikan"
                                android:textColor="#17171B"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="#F0F0F0" />

                    <!-- 4. "Semua episode" Header & Horizontal Cards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Semua episode"
                            android:textColor="#17171B"
                            android:textSize="15.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetailTotalEps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tamat"
                            android:textColor="#757580"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Horizontal Scrolling Episode Cards -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvDetailEpisodes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:clipToPadding="false"
                        android:orientation="horizontal" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:background="#F0F0F0" />

                    <!-- 5. "Pilih Server / Kualitas" Section -->
                    <LinearLayout
                        android:id="@+id/serverSectionLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Pilih Server / Kualitas"
                                android:textColor="#17171B"
                                android:textSize="15sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ganti jika lemot"
                                android:textColor="#757580"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvDetailResolutions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:clipToPadding="false"
                            android:orientation="horizontal" />
                    </LinearLayout>

                    <!-- 6. Portrait Recommendations Section (Only visible in Portrait mode) -->
                    <LinearLayout
                        android:id="@+id/portraitRecommendationsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="16dp"
                            android:background="#F0F0F0" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Direkomendasikan untukmu"
                            android:textColor="#17171B"
                            android:textSize="15.5sp"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvRecommendedAnime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

        <!-- Vertical Column Divider -->
        <View
            android:id="@+id/columnDivider"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#EDEDF0"
            android:visibility="gone" />

        <!-- RIGHT COLUMN (Landscape Rekomendasi Grid - iQIYI Style) -->
        <LinearLayout
            android:id="@+id/rightColumnLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="38"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Header: Rekomendasi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp">

                <TextView
                    android:id="@+id/tvLandscapeRecHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Rekomendasi"
                    android:textColor="#17171B"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Anime Terkait"
                    android:textColor="#8E8E93"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0" />

            <!-- Grid of Recommended Anime Cards (3 Columns) -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvLandscapeRecommendations"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="6dp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
