<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/search_pill_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <ImageView
        android:id="@+id/ivDownloadPoster"
        android:layout_width="38dp"
        android:layout_height="48dp"
        android:background="#232328"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvDownloadTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Judul Anime"
            android:textColor="#17171B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDownloadEpisode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Episode 1 • Siap Offline"
            android:textColor="#10B981"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Button
        android:id="@+id/btnPlayOffline"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:backgroundTint="#FFCC00"
        android:minHeight="0dp"
        android:paddingHorizontal="10dp"
        android:paddingVertical="0dp"
        android:text="Putar"
        android:textColor="#17171B"
        android:textSize="11.5sp"
        android:textStyle="bold" />
</LinearLayout>
